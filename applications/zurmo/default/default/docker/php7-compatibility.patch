@@ -34,6 +34,43 @@
      * "Copyright Zurmo Inc. 2013. All rights reserved".
      ********************************************************************************/
 
+if (!function_exists('mysql_connect')) {
+    function mysql_connect($server = null, $username = null, $password = null) {
+        $parts = explode(':', (string)$server);
+        $host = $parts[0];
+        $port = isset($parts[1]) ? (int)$parts[1] : 3306;
+        $link = @mysqli_connect($host, $username, $password, '', $port);
+        if ($link) {
+            $GLOBALS['__last_mysql_link'] = $link;
+        }
+        return $link;
+    }
+    function mysql_select_db($db, $link = null) {
+        $link = $link ?: ($GLOBALS['__last_mysql_link'] ?? null);
+        return $link ? @mysqli_select_db($link, $db) : false;
+    }
+    function mysql_query($query, $link = null) {
+        $link = $link ?: ($GLOBALS['__last_mysql_link'] ?? null);
+        return $link ? @mysqli_query($link, $query) : false;
+    }
+    function mysql_fetch_row($result) {
+        return $result ? @mysqli_fetch_row($result) : false;
+    }
+    function mysql_close($link = null) {
+        $link = $link ?: ($GLOBALS['__last_mysql_link'] ?? null);
+        if ($link) return @mysqli_close($link);
+        return true;
+    }
+    function mysql_errno($link = null) {
+        $link = $link ?: ($GLOBALS['__last_mysql_link'] ?? null);
+        return $link ? mysqli_errno($link) : 0;
+    }
+    function mysql_error($link = null) {
+        $link = $link ?: ($GLOBALS['__last_mysql_link'] ?? null);
+        return $link ? mysqli_error($link) : '';
+    }
+}
