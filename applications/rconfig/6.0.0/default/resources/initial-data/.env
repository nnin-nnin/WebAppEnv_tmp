APP_NAME="rConfig V8 Core - Network Configuration Management"
APP_ENV=production
APP_KEY=base64:3v74X9v9d3XkXyG+Q8+5t8N3W0/wG4f5U8L2T6X9v9d=
APP_DEBUG=false
APP_URL=http://localhost:18551
APP_FORCE_HTTPS=false
APP_DIR_PATH=/var/www/html/rconfig

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rconfig
DB_USERNAME=rconfig
DB_PASSWORD=AdminPassword123!

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=rConfigp

HORIZON_PREFIX=rConfig
HORIZON_LOCAL_TIMEOUT=120
HORIZON_PROD_TIMEOUT=120
HORIZON_MIN_PROCESS=1
HORIZON_MAX_PROCESS=10
HORIZON_DEFAULT_MAX_PROCESS=5

QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
REDIS_QUEUE_RETRY_AFTER=130

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
